prisma:query 
      SELECT 
        "type", 
        "title", 
        "body", 
        MAX("createdAt") as "sentOn", 
        COUNT(*) as "sentCount"
      FROM "Notification"
      GROUP BY "type", "title", "body"
      ORDER BY "sentOn" DESC
      LIMIT 50
    
prisma:query 
