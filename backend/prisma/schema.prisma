// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ─────────────────────────────────────────────────────────────────

enum Role {
  FARMER
  BUYER
  DELIVERY
  ADMIN
}

enum VehicleType {
  BIKE
  AUTO
  TEMPO
  MINI_TRUCK
}

enum CropStatus {
  ACTIVE
  PAUSED
  BOOKED
  HARVESTED
  CLOSED
}

enum RoleAccessStatus {
  ACTIVE
  BLOCKED
  PENDING_APPROVAL
  REJECTED
}

enum UnbanFeeStatus {
  NONE
  PENDING
  PAID
}

enum DeliveryOfferStatus {
  OFFERED
  DECLINED
  EXPIRED
  ACCEPTED
  LOST
}

enum LedgerEntryType {
  FARMER_EARNING
  DELIVERY_EARNING
  PLATFORM_CROP_FEE
  PLATFORM_DELIVERY_FEE
  CASH_LIABILITY
  REFUND
  PAYOUT
}

enum LedgerEntryStatus {
  PENDING
  AVAILABLE
  SETTLED
  FAILED
  VOIDED
}

enum CropCategory {
  VEGETABLES
  FRUITS
  GRAINS
  HERBS
  DAIRY
  PULSES
  OILSEEDS
  OTHER
}

enum NotificationAlertLevel {
  INFO // Normal updates (e.g., "Order placed")
  WARNING // Strike/Warning (e.g., "You have 5 complaints")
  CRITICAL // Ban/Block (e.g., "Account suspended")
  SUCCESS // Positive actions (e.g., "Payment received")
}

enum NotificationType {
  GENERAL
  ANNOUNCEMENT
  WARNING
  MAINTENANCE
  OFFER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  DELIVERY_SEARCHING
  DELIVERY_UNAVAILABLE
  ASSIGNED
  PICKED_UP
  IN_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliveryType {
  DELIVERY
  SELF_PICKUP
}

enum PaymentType {
  ONLINE
  CASH_ON_PICKUP
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OtpKind {
  PICKUP
  DELIVERY
}

enum DeliveryJobStatus {
  ASSIGNED
  PICKED_UP
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ReviewTargetType {
  FARMER
  BUYER
  DELIVERY
}

// ── MODELS ────────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(cuid())
  firebaseUid String  @unique
  name        String?
  email       String? // Contact only, unverified. Never use it to find or log in a user.
  phone       String  @unique // The login identity. Only ever set from a verified source, as +91XXXXXXXXXX.
  activeRole  Role    @default(BUYER) // A database trigger keeps this to a role the user holds in UserRoleAccess.

  // Identity
  aboutMe      String?
  dob          DateTime?
  gender       String?
  languagePref String?

  // Location
  latitude  Float?
  longitude Float?
  village   String?
  district  String?
  state     String?
  pincode   String?

  // Financial
  walletBalance Decimal @default(0) @db.Decimal(10, 2)

  // Trust & Penalties
  rating      Float   @default(0)
  ratingCount Int     @default(0)
  isVerified  Boolean @default(false)
  isActive    Boolean @default(true)
  strikeCount Int     @default(0) // Yeh complaints track karega (5, 7, 10 rules ke liye)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  farmerProfile      FarmerProfile?
  deliveryProfile    DeliveryProfile?
  bankDetails        BankDetails?
  kycDocuments       KycDocuments?
  crops              Crop[]
  ordersAsBuyer      Order[]           @relation("BuyerOrders")
  ordersAsFarmer     Order[]           @relation("FarmerOrders")
  deliveryJobs       DeliveryJob[]
  reviewsGiven       Review[]          @relation("GivenReviews")
  reviewsReceived    Review[]          @relation("ReceivedReviews")
  notifications      Notification[]
  roleAccess         UserRoleAccess[]  @relation("RoleAccessUser")
  roleChangesMade    UserRoleAccess[]  @relation("RoleAccessChangedBy")
  roleEventsCaused   RoleAccessEvent[] @relation("RoleEventChangedBy")
  cashReconciled     CashLiability[]   @relation("CashReconciledBy")
  complaintsResolved Complaint[]       @relation("ComplaintsResolvedBy")
  deliveryOffers     DeliveryOffer[]
  ledgerEntries      LedgerEntry[]
  payoutsProcessed   PayoutDetail[]    @relation("PayoutsProcessed")
  cashLiabilities    CashLiability[]
  complaintsFiled    Complaint[]       @relation("ComplaintsFiled")
  complaintsReceived Complaint[]       @relation("ComplaintsReceived")

  @@index([latitude, longitude])
}

model FarmerProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmArea     Float?
  primaryCrops String?
  farmingType  String?
  soilType     String?
  waterSource  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DeliveryProfile {
  userId            String       @id
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType       VehicleType?
  vehicleNumber     String?
  vehicleColor      String?
  coverageRadiusKm  Int?
  isOnline          Boolean      @default(false)
  dailyEarningsGoal Decimal      @default(2000) @db.Decimal(10, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([isOnline])
}

model BankDetails {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount       String? // Encrypted by the application.
  bankIfsc          String?
  bankName          String?
  accountHolderName String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model KycDocuments {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aadhaarLast4    String?
  aadhaarUrl      String? // The three document fields are encrypted by the application.
  aadhaarVerified Boolean  @default(false)
  dlUrl           String?
  dlVerified      Boolean  @default(false)
  rcUrl           String?
  rcVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserRoleAccess {
  id               String           @id @default(cuid())
  user             User             @relation("RoleAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  role             Role
  status           RoleAccessStatus @default(ACTIVE)
  reason           String?
  blockedAt        DateTime?
  blockedUntil     DateTime?
  changedByAdmin   User?            @relation("RoleAccessChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
  changedByAdminId String? // The admin behind the latest status change. Empty for automatic changes.
  unbanFeeStatus   UnbanFeeStatus   @default(NONE)
  unbanFeeAmount   Decimal?         @db.Decimal(10, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  events RoleAccessEvent[]

  @@unique([userId, role])
  @@index([changedByAdminId])
  @@index([role, status, blockedUntil])
}

// One row for every status change of a role, written by a trigger in the migrations.
model RoleAccessEvent {
  id               String            @id @default(cuid())
  userRoleAccess   UserRoleAccess    @relation(fields: [userRoleAccessId], references: [id], onDelete: Cascade)
  userRoleAccessId String
  fromStatus       RoleAccessStatus?
  toStatus         RoleAccessStatus
  reason           String?
  blockedUntil     DateTime?
  changedByAdmin   User?             @relation("RoleEventChangedBy", fields: [changedByAdminId], references: [id], onDelete: Restrict)
  changedByAdminId String?
  createdAt        DateTime          @default(now())

  @@index([userRoleAccessId, createdAt])
  @@index([changedByAdminId])
}

// NAYA MODEL: Admin dwara set kiye gaye fasalon ke naam (English/Hindi)
model CropCatalog {
  id            String       @id @default(cuid())
  englishName   String // e.g., "Potato"
  hindiName     String // e.g., "Aloo (आलू)"
  category      CropCategory // Fruits, Vegetables etc.
  imageTemplate String? // Default image URL agar farmer apni photo na daale
  isActive      Boolean      @default(true) // Admin chahe toh kisi fasal ko temporarily band kar de
  createdAt     DateTime     @default(now())

  crops Crop[] // Ek catalog item se hazaron kisaan fasal bech sakte hain

  @@index([category, isActive])
}

model Crop {
  id String @id @default(cuid())

  // Relation with User (Farmer)
  farmer   User   @relation(fields: [farmerId], references: [id])
  farmerId String

  // NAYA LOGIC: Fasal ka naam ab direct string nahi, Catalog se aayega
  catalog   CropCatalog @relation(fields: [catalogId], references: [id])
  catalogId String

  description String?

  // Financial & Weights
  quantityKg          Decimal @db.Decimal(10, 2)
  quantityRemainingKg Decimal @db.Decimal(10, 2)
  basePricePerKg      Decimal @db.Decimal(10, 2)
  minOrderKg          Decimal @db.Decimal(10, 2)

  // Dates & Media
  harvestDate DateTime
  photos      String[]

  // Farm Location
  farmLatitude  Float
  farmLongitude Float
  farmVillage   String
  farmDistrict  String
  farmState     String

  // Toggles & Constraints
  selfPickupEnabled  Boolean   @default(false)
  isPreHarvest       Boolean   @default(false)
  preHarvestDeadline DateTime?

  // Status & Analytics
  status     CropStatus @default(ACTIVE)
  viewsCount Int        @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  orders Order[]
  offer  CropOffer? // Optional Bulk Offer Relation

  @@unique([id, farmerId]) // Lets an order prove its farmer really owns the crop.
  @@index([farmerId])
  @@index([status, catalogId]) // Update kiya gaya index
  @@index([harvestDate])
  @@index([farmLatitude, farmLongitude])
}

// NAYA MODEL: Bulk Quantity par discount dene ke liye (e.g., 50kg lo, 20% off pao)
model CropOffer {
  id String @id @default(cuid())

  // 1-to-1 Relation: Ek fasal par ek hi discount offer lag sakta hai
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  cropId String @unique

  minQuantityKg      Decimal @db.Decimal(10, 2) // Discount tab milega jab order kam se kam itna ho
  discountPercentage Decimal @db.Decimal(5, 2) // Kitne % chhoot deni hai

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(cuid())

  crop   Crop   @relation(fields: [cropId, farmerId], references: [id, farmerId])
  cropId String

  farmer   User   @relation("FarmerOrders", fields: [farmerId], references: [id])
  farmerId String
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId  String

  quantityKg             Decimal @db.Decimal(10, 2)
  basePricePerKg         Decimal @db.Decimal(10, 2)
  farmerEarnings         Decimal @db.Decimal(10, 2)
  cropMarkupRate         Decimal @db.Decimal(5, 4)
  platformFee            Decimal @db.Decimal(10, 2)
  deliveryFee            Decimal @default(0) @db.Decimal(10, 2)
  deliveryCommissionRate Decimal @default(0) @db.Decimal(5, 4)
  deliveryPlatformFee    Decimal @default(0) @db.Decimal(10, 2)
  deliveryPartnerPayout  Decimal @default(0) @db.Decimal(10, 2)
  discountAmount         Decimal @default(0) @db.Decimal(10, 2) // NAYA: Bulk discount amount yahan save hoga
  totalBuyerPrice        Decimal @db.Decimal(10, 2)

  deliveryType DeliveryType
  paymentType  PaymentType

  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryAddress   String?
  deliveryDate      DateTime?

  status OrderStatus @default(PENDING)

  cancellationReason     String?
  farmerResponseDeadline DateTime?
  farmerAcceptedAt       DateTime?
  dispatchStartedAt      DateTime?
  completedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryJobs   DeliveryJob[]
  reviews        Review[]
  deliveryOffers DeliveryOffer[]
  paymentRecord  PaymentRecord?
  ledgerEntries  LedgerEntry[]
  cashLiability  CashLiability?
  complaints     Complaint[]
  statusHistory  OrderStatusHistory[]
  otps           OrderOtp[]

  @@index([buyerId, status])
  @@index([farmerId, status])
  @@index([createdAt])
  @@index([cropId])
  @@index([status, createdAt])
}

// Kept apart from Order so that loading an order can never expose these codes by accident.
model OrderOtp {
  id            String    @id @default(cuid())
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId       String
  kind          OtpKind
  code          String
  wrongAttempts Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orderId, kind])
}

// One row for every status an order has been in, written by a trigger in the migrations. Permanent.
model OrderStatusHistory {
  id         String       @id @default(cuid())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model DeliveryJob {
  id String @id @default(cuid())

  // An order can have many jobs over time, but only one that is not CANCELLED. A partial unique
  // index in the migrations enforces that, because Prisma cannot describe one here.
  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  deliveryPartner   User   @relation(fields: [deliveryPartnerId], references: [id])
  deliveryPartnerId String

  pickupLatitude  Float
  pickupLongitude Float
  dropLatitude    Float
  dropLongitude   Float
  distanceKm      Float

  cropWeightKg Decimal           @db.Decimal(10, 2)
  status       DeliveryJobStatus @default(ASSIGNED)

  liveLatitude          Float?
  liveLongitude         Float?
  liveLocationUpdatedAt DateTime?

  pickupPhoto   String?
  deliveryPhoto String?

  acceptedAt          DateTime  @default(now())
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  estimatedDeliveryAt DateTime?
  createdAt           DateTime  @default(now())

  @@index([orderId])
  @@index([deliveryPartnerId, status])
  @@index([pickupLatitude, pickupLongitude])
}

model DeliveryOffer {
  id          String              @id @default(cuid())
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  partner     User                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId   String
  wave        Int
  radiusKm    Int
  status      DeliveryOfferStatus @default(OFFERED)
  offeredAt   DateTime            @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@unique([orderId, partnerId, wave]) // Each retry is a new wave, so a partner can be offered again.
  @@index([partnerId, status, expiresAt])
  @@index([orderId, wave])
}

// The buyer's payment for one order. Its attempts and refunds are kept as separate rows below.
model PaymentRecord {
  id                String        @id @default(cuid())
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId           String        @unique
  provider          String
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  authorizedAt      DateTime?
  capturedAt        DateTime?
  refundedAt        DateTime? // Set only once the full amount has been refunded.
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  attempts PaymentAttempt[]
  refunds  Refund[]
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  paymentRecord     PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Restrict)
  paymentRecordId   String
  providerPaymentId String        @unique
  status            PaymentStatus
  amount            Decimal       @db.Decimal(10, 2)
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([paymentRecordId])
}

model Refund {
  id               String        @id @default(cuid())
  paymentRecord    PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Restrict)
  paymentRecordId  String
  providerRefundId String        @unique
  amount           Decimal       @db.Decimal(10, 2)
  status           RefundStatus  @default(PENDING)
  reason           String?
  processedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([paymentRecordId])
}

// The amount, owner and order of an entry never change, and it can't be deleted. Only its status can
// move, and only forward. A trigger in the migrations enforces all of this.
model LedgerEntry {
  id             String            @id @default(cuid())
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId        String? // Empty only for a PAYOUT, which comes from the wallet rather than one order.
  user           User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId         String? // Empty only for the platform's own fees.
  type           LedgerEntryType
  status         LedgerEntryStatus @default(PENDING)
  amount         Decimal           @db.Decimal(10, 2)
  idempotencyKey String            @unique
  availableAt    DateTime?
  settledAt      DateTime?
  createdAt      DateTime          @default(now())

  payoutDetail PayoutDetail?

  @@index([userId, status])
  @@index([orderId, type])
}

// Where a payout's money was sent. Copied at request time, so changing a profile can't change it.
model PayoutDetail {
  id                 String      @id @default(cuid())
  ledgerEntry        LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  ledgerEntryId      String      @unique
  bankAccount        String
  bankIfsc           String
  bankName           String?
  accountHolderName  String?
  processedByAdmin   User?       @relation("PayoutsProcessed", fields: [processedByAdminId], references: [id], onDelete: Restrict)
  processedByAdminId String?
  processedAt        DateTime?
  createdAt          DateTime    @default(now())

  @@index([processedByAdminId])
}

enum CashDepositStatus {
  PENDING_DEPOSIT
  DEPOSITED
  VERIFIED
  OVERDUE
}

model CashLiability {
  id                  String            @id @default(cuid())
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId             String            @unique
  deliveryPartner     User              @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)
  deliveryPartnerId   String
  amount              Decimal           @db.Decimal(10, 2)
  status              CashDepositStatus @default(PENDING_DEPOSIT)
  depositedAt         DateTime?
  reconciledAt        DateTime?
  reconciledByAdmin   User?             @relation("CashReconciledBy", fields: [reconciledByAdminId], references: [id], onDelete: Restrict)
  reconciledByAdminId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([reconciledByAdminId])
  @@index([deliveryPartnerId, status])
}

model Review {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  reviewer   User   @relation("GivenReviews", fields: [reviewerId], references: [id])
  reviewerId String

  target   User   @relation("ReceivedReviews", fields: [targetId], references: [id])
  targetId String

  targetType ReviewTargetType

  rating  Int
  comment String?

  isFlagged Boolean @default(false)
  flagCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, reviewerId, targetId])
  @@index([reviewerId])
  @@index([targetId])
}

model Notification {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  type       NotificationType       @default(GENERAL)
  alertLevel NotificationAlertLevel @default(INFO) // NAYA: Warning ko highlight karne ke liye

  title  String
  body   String
  data   Json?
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Complaint {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  complainerId String
  complainer   User   @relation("ComplaintsFiled", fields: [complainerId], references: [id])

  accusedId String
  accused   User   @relation("ComplaintsReceived", fields: [accusedId], references: [id])

  accusedRole Role

  reason            String
  description       String?
  evidence          String[]  @default([])
  adminRemark       String?
  resolvedByAdmin   User?     @relation("ComplaintsResolvedBy", fields: [resolvedByAdminId], references: [id], onDelete: Restrict)
  resolvedByAdminId String?
  resolvedAt        DateTime?

  status ComplaintStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accusedId, accusedRole])
  @@index([orderId])
  @@index([complainerId])
  @@index([resolvedByAdminId])
  @@index([status])
}

enum ComplaintStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  DISMISSED
}

// NAYA MODEL: Platform level settings that admin can change
model PlatformSettings {
  id                 String   @id @default(cuid())
  cropMarkupRate     Decimal  @default(0.20) @db.Decimal(5, 4)
  deliveryMarkupRate Decimal  @default(0.20) @db.Decimal(5, 4)
  updatedAt          DateTime @updatedAt
}
