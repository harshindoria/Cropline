// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ─────────────────────────────────────────────────────────────────

enum Role {
  FARMER
  BUYER
  DELIVERY
  ADMIN
}

enum VehicleType {
  BIKE
  AUTO
  TEMPO
  MINI_TRUCK
}

enum CropStatus {
  ACTIVE
  PAUSED
  BOOKED
  HARVESTED
  CLOSED
}

enum RoleAccessStatus {
  ACTIVE
  BLOCKED
}

enum DeliveryOfferStatus {
  OFFERED
  DECLINED
  EXPIRED
  ACCEPTED
  LOST
}

enum VerificationPurpose {
  FARMER_HANDOVER
  BUYER_DELIVERY
}

enum LedgerEntryType {
  FARMER_EARNING
  DELIVERY_EARNING
  PLATFORM_CROP_FEE
  PLATFORM_DELIVERY_FEE
  CASH_LIABILITY
  REFUND
  PAYOUT
}

enum LedgerEntryStatus {
  PENDING
  AVAILABLE
  SETTLED
  VOIDED
}

enum CropCategory {
  VEGETABLES
  FRUITS
  GRAINS
  HERBS
  DAIRY
  OTHER
}

// Naya Enum: Notifications ki priority set karne ke liye (Warnings ke liye)
enum NotificationAlertLevel {
  INFO       // Normal updates (e.g., "Order placed")
  WARNING    // Strike/Warning (e.g., "You have 5 complaints")
  CRITICAL   // Ban/Block (e.g., "Account suspended")
  SUCCESS    // Positive actions (e.g., "Payment received")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  DELIVERY_SEARCHING
  DELIVERY_UNAVAILABLE
  ASSIGNED
  PICKED_UP
  IN_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliveryType {
  DELIVERY
  SELF_PICKUP
}

enum PaymentType {
  ONLINE
  CASH_ON_PICKUP
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
}

enum DeliveryJobStatus {
  ASSIGNED
  PICKED_UP
  IN_DELIVERY
  DELIVERED
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum ReviewTargetType {
  FARMER
  BUYER
  DELIVERY
}

// ── MODELS ────────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(cuid())
  firebaseUid String  @unique
  name        String?
  email       String? @unique
  phone       String? @unique
  roles       Role[]  @default([BUYER])
  activeRole  Role    @default(BUYER)

  // Identity
  aadhaarLast4 String?

  // Location
  latitude  Float?
  longitude Float?
  village   String?
  district  String?
  state     String?
  pincode   String?

  // Delivery partner specific
  vehicleType      VehicleType?
  coverageRadiusKm Int?
  isOnline         Boolean      @default(false)

  // Financial
  bankAccount   String? 
  bankIfsc      String? 
  walletBalance Decimal @default(0) @db.Decimal(10, 2)

  // Trust & Penalties
  rating      Float   @default(0)
  ratingCount Int     @default(0)
  isVerified  Boolean @default(false)
  isActive    Boolean @default(true)
  strikeCount Int     @default(0) // Yeh complaints track karega (5, 7, 10 rules ke liye)

  // Push notifications
  fcmToken String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  crops                 Crop[]
  ordersAsBuyer         Order[]          @relation("BuyerOrders")
  ordersAsFarmer        Order[]          @relation("FarmerOrders")
  deliveryJobs          DeliveryJob[]
  reviewsGiven          Review[]         @relation("GivenReviews")
  reviewsReceived       Review[]         @relation("ReceivedReviews")
  subscriptionsAsBuyer  Subscription[]   @relation("BuyerSubscriptions")
  subscriptionsAsFarmer Subscription[]   @relation("FarmerSubscriptions")
  notifications         Notification[]
  roleAccess            UserRoleAccess[] @relation("RoleAccessUser")
  roleBlocksIssued      UserRoleAccess[] @relation("RoleAccessBlockedBy")
  deliveryOffers        DeliveryOffer[]
  ledgerEntries         LedgerEntry[]
  cashLiabilities       CashLiability[]

  @@index([latitude, longitude]) 
  @@index([activeRole, isOnline]) 
}

model UserRoleAccess {
  id               String           @id @default(cuid())
  user             User             @relation("RoleAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  role             Role
  status           RoleAccessStatus @default(ACTIVE)
  reason           String?
  blockedAt        DateTime?
  blockedUntil     DateTime?
  blockedByAdmin   User?            @relation("RoleAccessBlockedBy", fields: [blockedByAdminId], references: [id], onDelete: SetNull)
  blockedByAdminId String?
  strikeCount      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, role])
  @@index([role, status, blockedUntil])
}

// NAYA MODEL: Admin dwara set kiye gaye fasalon ke naam (English/Hindi)
model CropCatalog {
  id            String       @id @default(cuid())
  englishName   String       // e.g., "Potato"
  hindiName     String       // e.g., "Aloo (आलू)"
  category      CropCategory // Fruits, Vegetables etc.
  imageTemplate String?      // Default image URL agar farmer apni photo na daale
  isActive      Boolean      @default(true) // Admin chahe toh kisi fasal ko temporarily band kar de
  createdAt     DateTime     @default(now())
  
  crops         Crop[]       // Ek catalog item se hazaron kisaan fasal bech sakte hain

  @@index([category, isActive])
}

model Crop {
  id String @id @default(cuid())

  // Relation with User (Farmer)
  farmer   User   @relation(fields: [farmerId], references: [id])
  farmerId String

  // NAYA LOGIC: Fasal ka naam ab direct string nahi, Catalog se aayega
  catalog   CropCatalog @relation(fields: [catalogId], references: [id])
  catalogId String

  description String?

  // Financial & Weights
  quantityKg          Decimal @db.Decimal(10, 2)
  quantityRemainingKg Decimal @db.Decimal(10, 2)
  basePricePerKg      Decimal @db.Decimal(10, 2)
  minOrderKg          Decimal @db.Decimal(10, 2)

  // Dates & Media
  harvestDate DateTime
  photos      String[] 

  // Farm Location
  farmLatitude  Float
  farmLongitude Float
  farmVillage   String
  farmDistrict  String
  farmState     String

  // Toggles & Constraints
  selfPickupEnabled  Boolean   @default(false)
  isPreHarvest       Boolean   @default(false)
  preHarvestDeadline DateTime?

  // Status & Analytics
  status     CropStatus @default(ACTIVE)
  viewsCount Int        @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  orders        Order[]
  subscriptions Subscription[]
  offer         CropOffer?     // Optional Bulk Offer Relation

  @@index([farmerId])
  @@index([status, catalogId]) // Update kiya gaya index
  @@index([harvestDate])
  @@index([farmLatitude, farmLongitude])
}

// NAYA MODEL: Bulk Quantity par discount dene ke liye (e.g., 50kg lo, 20% off pao)
model CropOffer {
  id                 String   @id @default(cuid())
  
  // 1-to-1 Relation: Ek fasal par ek hi discount offer lag sakta hai
  crop               Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  cropId             String   @unique 
  
  minQuantityKg      Decimal  @db.Decimal(10, 2) // Discount tab milega jab order kam se kam itna ho
  discountPercentage Decimal  @db.Decimal(5, 2)  // Kitne % chhoot deni hai
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Order {
  id String @id @default(cuid())

  crop   Crop   @relation(fields: [cropId], references: [id])
  cropId String

  farmer   User   @relation("FarmerOrders", fields: [farmerId], references: [id])
  farmerId String
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId  String

  isSubscription Boolean       @default(false)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  quantityKg             Decimal @db.Decimal(10, 2)
  basePricePerKg         Decimal @db.Decimal(10, 2)
  farmerEarnings         Decimal @db.Decimal(10, 2)
  cropMarkupRate         Decimal @db.Decimal(5, 4)
  platformFee            Decimal @db.Decimal(10, 2)
  deliveryFee            Decimal @default(0) @db.Decimal(10, 2)
  deliveryCommissionRate Decimal @default(0) @db.Decimal(5, 4)
  deliveryPlatformFee    Decimal @default(0) @db.Decimal(10, 2)
  deliveryPartnerPayout  Decimal @default(0) @db.Decimal(10, 2)
  discountAmount         Decimal @default(0) @db.Decimal(10, 2) // NAYA: Bulk discount amount yahan save hoga
  totalBuyerPrice        Decimal @db.Decimal(10, 2)

  deliveryType DeliveryType
  paymentType  PaymentType

  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryAddress   String?
  deliveryDate      DateTime?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String? 
  qrCode        String? 
  pickupOtp     String?

  cancellationReason     String?
  farmerResponseDeadline DateTime?
  farmerAcceptedAt       DateTime?
  paymentAuthorizedAt    DateTime?
  paymentCapturedAt      DateTime?
  dispatchStartedAt      DateTime?
  completedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryJob        DeliveryJob?
  reviews            Review[]
  deliveryOffers     DeliveryOffer[]
  verificationTokens VerificationToken[]
  paymentRecord      PaymentRecord?
  ledgerEntries      LedgerEntry[]
  cashLiability      CashLiability?

  @@index([buyerId, status])
  @@index([farmerId, status])
  @@index([createdAt])
}

model DeliveryJob {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique 

  deliveryPartner   User   @relation(fields: [deliveryPartnerId], references: [id])
  deliveryPartnerId String

  pickupLatitude  Float
  pickupLongitude Float
  dropLatitude    Float
  dropLongitude   Float
  distanceKm      Float

  cropWeightKg Decimal           @db.Decimal(10, 2)
  status       DeliveryJobStatus @default(ASSIGNED)

  liveLatitude          Float?
  liveLongitude         Float?
  liveLocationUpdatedAt DateTime?

  pickupPhoto   String?
  deliveryPhoto String?

  acceptedAt          DateTime  @default(now())
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  estimatedDeliveryAt DateTime?
  createdAt           DateTime  @default(now())
  offeredAt           DateTime  @default(now()) 
  acceptanceDeadline  DateTime? 
  notifiedPartners    String[]  @default([]) 

  @@index([deliveryPartnerId, status])
  @@index([pickupLatitude, pickupLongitude]) 
}

model DeliveryOffer {
  id          String              @id @default(cuid())
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  partner     User                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId   String
  wave        Int
  radiusKm    Int
  status      DeliveryOfferStatus @default(OFFERED)
  offeredAt   DateTime            @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@unique([orderId, partnerId])
  @@index([partnerId, status, expiresAt])
  @@index([orderId, wave])
}

model VerificationToken {
  id             String              @id @default(cuid())
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  purpose        VerificationPurpose
  jti            String              @unique
  issuedToUserId String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([orderId, purpose, consumedAt])
}

model PaymentRecord {
  id                String        @id @default(cuid())
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String        @unique
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  authorizedAt      DateTime?
  capturedAt        DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model LedgerEntry {
  id             String            @id @default(cuid())
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId        String
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  type           LedgerEntryType
  status         LedgerEntryStatus @default(PENDING)
  amount         Decimal           @db.Decimal(10, 2)
  idempotencyKey String            @unique
  availableAt    DateTime?
  settledAt      DateTime?
  createdAt      DateTime          @default(now())

  @@index([userId, status])
  @@index([orderId, type])
}

model CashLiability {
  id                  String    @id @default(cuid())
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId             String    @unique
  deliveryPartner     User      @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)
  deliveryPartnerId   String
  amount              Decimal   @db.Decimal(10, 2)
  reconciledAt        DateTime?
  reconciledByAdminId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([deliveryPartnerId, reconciledAt])
}

model Review {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  reviewer   User   @relation("GivenReviews", fields: [reviewerId], references: [id])
  reviewerId String

  target   User   @relation("ReceivedReviews", fields: [targetId], references: [id])
  targetId String

  targetType ReviewTargetType

  rating  Int 
  comment String? 

  isFlagged Boolean @default(false)
  flagCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, reviewerId, targetId])
  @@index([targetId])
}

model Subscription {
  id String @id @default(cuid())

  buyer   User   @relation("BuyerSubscriptions", fields: [buyerId], references: [id])
  buyerId String

  farmer   User   @relation("FarmerSubscriptions", fields: [farmerId], references: [id])
  farmerId String

  crop   Crop   @relation(fields: [cropId], references: [id])
  cropId String

  quantityKgPerDelivery Decimal               @db.Decimal(10, 2)
  frequency             SubscriptionFrequency
  deliveryType          DeliveryType 
  deliveryDay           String 
  lockPrice             Boolean               @default(false) 
  lockedPrice           Decimal?              @db.Decimal(10, 2) 

  startDate        DateTime
  endDate          DateTime? 
  nextDeliveryDate DateTime 

  deliveryLatitude  Float
  deliveryLongitude Float
  deliveryAddress   String

  status SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([buyerId, status])
  @@index([farmerId, status])
  @@index([nextDeliveryDate, status]) 
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  
  type      String   // e.g., "NEW_ORDER", "WARNING"
  alertLevel NotificationAlertLevel @default(INFO) // NAYA: Warning ko highlight karne ke liye

  title     String
  body      String
  data      Json?    
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())

  @@index([userId, isRead]) 
  @@index([createdAt]) 
}